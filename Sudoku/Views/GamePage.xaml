<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sudoku.Views.GamePage"
              BackgroundColor="#252525"
                Title="Sudoku">
    <Grid Padding="7"
          RowDefinitions="Auto,Auto,*,Auto,Auto"
          RowSpacing="15">
    <VerticalStackLayout
        Padding="7"
        Spacing="10"
        VerticalOptions="Center">

        <Label
            Text="SUDOKU"
            FontSize="32"
            FontAttributes="Bold"
            TextColor="#E5E5DD"
            HorizontalOptions="Center"/>

        <Label
            x:Name="DifficultyLabel"
            FontSize="20"
            TextColor="#888888"
            HorizontalOptions="Center"/>

       

    </VerticalStackLayout>

    <Grid Grid.Row="1"
              ColumnDefinitions="*,*">

        <VerticalStackLayout Grid.Column="0"
                                 HorizontalOptions="Center">
            <Label Text="TIME"
                       FontSize="11"
                       TextColor="#888888"/>
            <Label x:Name="TimerLabel"
                       Text="00:00"
                       FontSize="20"
                       TextColor="#888888"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Column="1"
                                 HorizontalOptions="Center">
            <Label Text="MISTAKES"
                       FontSize="11"
                       TextColor="#888888"/>
            <Label x:Name="MistakesLabel"
                       Text="0"
                       FontSize="20"
                       TextColor="#888888"/>
        </VerticalStackLayout>

    </Grid>

    <Grid Grid.Row="2"
              x:Name="SudokuBoard"
              BackgroundColor="#252525"
              Padding="0"
              RowSpacing="0"
              ColumnSpacing="0"
              VerticalOptions="Center"
              HorizontalOptions="Center"
                
              />

            <Grid Grid.Row="3"
              x:Name="NumberPad"
              ColumnDefinitions="*,*,*,*,*,*,*,*,*"
              ColumnSpacing="3"
              />

    <Grid Grid.Row="4"
              ColumnDefinitions="*,*"
              ColumnSpacing="15">

        <Button
                Grid.Column="0"
                Text="ERASE"
                BackgroundColor="#252525"
                TextColor="#E5E5DD"
                CornerRadius="10"
                Clicked="OnEraseClicked"/>

        <Button
                Grid.Column="1"
                Text="HINT"
                BackgroundColor="#252525"
                TextColor="White"
                CornerRadius="10"
                Clicked="OnHintClicked"/>

    </Grid>

    </Grid>

</ContentPage>