<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sudoku.MainPage"
             BackgroundColor="#F5F5F0"
             NavigationPage.HasNavigationBar="False">

    <Grid Padding="30"
                  RowDefinitions="*,Auto,*">
        <VerticalStackLayout
            Grid.Row="0"
            VerticalOptions="End"
            HorizontalOptions="Center"
            Spacing="10">

            <Label
                Text="SUDOKU"
                FontSize="42"
                FontAttributes="Bold"
                TextColor="#252525"
                HorizontalOptions="Center"/>

            <Label
                Text="Challenge your mind"
                FontSize="16"
                TextColor="#888888"
                HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="1" 
            Spacing="15" 
            VerticalOptions="Center">
            <Button
                Text="NEW GAME"
                BackgroundColor="#252525"
                TextColor="White"
                FontSize="18"
                HeightRequest="60"
                CornerRadius="12"
                Clicked="OnNewGameClicked"/>
            <Button
                Text="STATISTICS"
                BackgroundColor="#E5E5DD"
                TextColor="#252525"
                FontSize="18"
                HeightRequest="60"
                CornerRadius="12"
                Clicked="OnStatisticsClicked"/>

        </VerticalStackLayout>
        <Label
            Grid.Row="2"
            Text="SUDOKU | BERINA MAJDANCIC"
            FontSize="11"
            TextColor="#999999"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0,0,0,15"/>
    </Grid>


</ContentPage>
